{
   readline_internal_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:readline
}
{
   readline_xmalloc_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   fun:xmalloc
   ...
   obj:*/libreadline.so*
}
{
   ncurses_tinfo_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libtinfo.so*
}
{
   readline_history_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:add_history
}