{
   readline_internal_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:readline
}
{
   readline_xmalloc_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   fun:xmalloc
   ...
   obj:*/libreadline.so*
}
{
   ncurses_tinfo_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libtinfo.so*
}
{
   readline_history_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:add_history
}
{
   readline_teardown_definite
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   fun:xmalloc
   fun:readline_internal_teardown
   fun:readline
   ...
}
{
   readline_definite_any
   Memcheck:Leak
   match-leak-kinds: definite
   ...
   obj:*/libreadline.so*
   ...
   fun:readline
}